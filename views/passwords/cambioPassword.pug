extends ../layout

block content 
    .login 
        h2 Cambiar contraseña 
        if error 
            p.error= error
        if mensaje 
            p.mensaje-exito= mensaje       

        form(action="/recuperacion/cambio-password" method="POST" onsubmit="return validarCoincidencia()")
            input(type="hidden" name="token" value=token)

            label(for="user") Usuario 
            input#user(
                type="text" 
                name="user" 
                value=user || ""
                required 
                placeholder="Ingresá tu usuario"
            )

            label(for="new-password") Nueva contraseña 
            .input-pass
                input#new-password(
                    type="password"
                    name="newPassword"
                    required 
                    minlength="6" 
                    maxlength="50"
                    pattern=".*[@$!%*?&#._\-].*"
                    oninvalid="validarPass(this)"
                    oninput="validarPass(this)"
                    placeholder="Ingresá tu nueva contraseña"
                )
                button.toggle-pass(type="button" onclick="togglePassword(this)" title="Ver contraseña"): i.fa-regular.fa-eye-slash

            label(for="repeat-password") Repita su contraseña 
            .input-pass
                input#repeat-password(
                    type="password"
                    name="repeatPassword"
                    required 
                    minlength="6" 
                    maxlength="50"
                    pattern=".*[@$!%*?&#._\-].*"
                    oninvalid="validarPass(this)"
                    oninput="validarPass(this)"
                    placeholder="Reingresá tu nueva contraseña"
                 )
                button.toggle-pass(type="button" onclick="togglePassword(this)" title="Ver contraseña"): i.fa-regular.fa-eye-slash
            button.boton(type="submit") Guardar contraseña
            button.boton.cancelar(type="button" onclick="window.location.href='/login'") Cancelar
    script.
      function validarPass(input) {
        const valor = input.value;
        const regexEspecial = /[@$!%*?&#._-]/;
        if (input.validity.valueMissing) {
          input.setCustomValidity('Por favor ingresá tu contraseña');
        } else if (valor.length < 6 || !regexEspecial.test(valor)) {
          input.setCustomValidity('La contraseña debe tener al menos 6 caracteres e incluir un símbolo especial');
        } else {
          input.setCustomValidity('');
        }
      }
      
      function validarCoincidencia() {
        const pass1 = document.getElementById('new-password').value;
        const pass2 = document.getElementById('repeat-password');
        if (pass1 !== pass2.value) {
          pass2.setCustomValidity('Las contraseñas no coinciden');
          pass2.reportValidity();
          return false;
        }
        pass2.setCustomValidity('');
        return true;
      }
