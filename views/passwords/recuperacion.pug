extends ../layout


block content 
    .login 
        h2 Recuperar contraseña
        .recupero
          p Ingresá el correo electrónico con el que te registraste en la aplicación y te enviaremos las instrucciones para restablecer tu contraseña.

          if error 
              p.error= error
          if mensaje 
              p.mensaje-exito= mensaje 

        form(action="/recuperacion" method="POST")            
          label(for="email") Correo Electrónico 
          input#email(
              type="email" 
              name="email" 
              value=email || ""
              required 
              placeholder="usuario@ejemplo.com"
          )

          if pedirUsuario
            label(for="usuario") Usuario
            input#usuario(
                type="text"
                name="usuario"
                required
                placeholder="Ingresá tu nombre de usuario"
            )
          
          button.boton(type="submit") Enviar
          button.boton.cancelar(type="button" onclick="window.location.href='/login'") Cancelar