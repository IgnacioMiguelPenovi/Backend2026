extends ../layout

block content
  h2= profesor ? 'Editar profesor' : 'Inscribir Profesor'
  form(action=profesor ? `/profesores/${profesor._id}` : '/profesores' method="POST")
    label(for="nombre") Nombre
    input(type="text" id="nombre" name="nombre" value=profesor ? profesor.nombre : '' required minlength="2" maxlength="50")

    label(for="apellido") Apellido
    input(type="text" id="apellido" name="apellido" value=profesor ? profesor.apellido : '' required minlength="2" maxlength="50")

    label(for="dni") DNI
    input(
      type="text" 
      id="dni" 
      name="dni" 
      value=profesor ? profesor.dni : '' 
      required 
      minlength="7"
      maxlength="8"
      placeholder="Ej. 12345678"
      oninput="validarDNI(this)"
    )
    span#error-dni(style="color: red; display: none; font-size: 0.85em; margin-top: 5px;") El DNI debe contener solo números.

    label(for="email") Email
    input(
      type="email" 
      id="email"
      name="email" 
      value=profesor ? profesor.email : '' 
      required
      oninvalid="this.setCustomValidity('Por favor, ingrese un correo electrónico válido')"
      oninput="this.setCustomValidity('')"
    )

    label(for="telefono") Teléfono
    input(
      type="tel" 
      id="telefono"
      name="telefono" 
      value=profesor ? profesor.telefono : '' 
      placeholder="Código de área sin el 0 y sin el 15. Ej: 1112345678"
      minlength="10"
      maxlength="12"
      required
      oninput="validarTelefono(this)"
    )
    span#error-telefono(style="color: red; display: none; font-size: 0.85em; margin-top: 5px;") El teléfono debe contener solo números (sin letras, espacios ni guiones).

    label(for="fechaNacimiento") Fecha de Nacimiento
    input(
      type="date" 
      id="fechaNacimiento" 
      name="fechaNacimiento" 
      value=(profesor && profesor.fechaNacimiento) ? new Date(profesor.fechaNacimiento).toISOString().split('T')[0] : ""
      required
      onchange="validarEdad(this)"
    )
    span#error-edad(style="color: red; display: none; font-size: 0.85em; margin-top: 5px;") La edad debe ser mayor o igual a 18 años.

    label(for="sucursal") Sucursal
    select(id="sucursal" name="sucursal" required)
      each sucursal in sucursales
        option(value=sucursal selected=(profesor && profesor.sucursal === sucursal))= sucursal

    label Días
    .checkboxes
      each dia in dias
        label.checkbox
          input(type="checkbox" name="dias" value=dia checked=(profesor && profesor.dias.includes(dia)))
          |  #{dia}

    label Horarios
    .checkboxes
      each horario in horarios
        label.checkbox
          input(type="checkbox" name="horarios" value=horario checked=(profesor && profesor.horarios.includes(horario)))
          |  #{horario}

          if !
            label(for="usuario") Usuario
            input#usuario(
              type="text"
              name="usuario"
              required
              minlength="3"
              maxlength="30"
          )

          label(for="contrasena") Contraseña
          input#contrasena(
            type="password"
            name="contrasena"
            required
            minlength="6"
            maxlength="50"
          )
    .enlaces
      button(type="submit")= profesor ? 'Guardar cambios' : 'Inscribir profesor'
      a.boton.cancelar(href="/profesores") Cancelar
    
  script(src="/js/validaciones.js")