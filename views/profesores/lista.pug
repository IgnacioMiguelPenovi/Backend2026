extends ../layout

block content
  h2 Profesores inscriptos

  if profesores.length === 0
    p No hay profesores inscriptos.
  else
    table
      thead
        tr
          th Nombre
          th Apellido
          th Sucursal
          th Días
          th Horarios
          th
      tbody
        each profesor in profesores
          tr
            td= profesor.nombre
            td= profesor.apellido
            td= profesor.sucursal
            td= profesor.dias.join(', ')
            td= profesor.horarios.join(', ')
            td
              a.boton(href=`/profesores/${profesor._id}`) Ver
              a.boton(href=`/profesores/${profesor._id}/editar`) Editar

  .enlaces
    a.boton.grande(href="/profesores/nuevo") Inscribir profesor
    a.boton.grande(href="/index") Volver al Inicio

