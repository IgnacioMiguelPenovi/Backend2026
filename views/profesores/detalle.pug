extends ../layout

block content
  - const activo = profesor.activo !== false
  h2= `${profesor.nombre} ${profesor.apellido}`
  ul.detalle
    li
      strong DNI:
      |  #{profesor.dni || 'No informado'}
    li
      strong Email:
      |  #{profesor.email || 'No informado'}
    li
      strong Teléfono:
      |  #{profesor.telefono || 'No informado'}
    li
      strong Estado:
      |  #{activo ? 'Activo' : 'Inactivo'}
    li
      strong Sucursal:
      |  #{profesor.sucursal}
    li
      strong Días:
      |  #{profesor.dias.join(', ')}
    li
      strong Horarios:
      |  #{profesor.horarios.join(', ')}

  .acciones
    a.boton(href=`/profesores/${profesor._id}/editar`) Editar
    if activo
      form(action=`/profesores/${profesor._id}/desactivar` method="POST" onsubmit="return confirm('¿Seguro que querés desactivar a este profesor?')")
        button.desactivar(type="submit") Desactivar
    else
      form(action=`/profesores/${profesor._id}/activar` method="POST")
        button(type="submit") Activar

  .volver 
   a.boton(href="/profesores") Volver al listado
