extends ../layout

block content
  h2= `${profesor.nombre} ${profesor.apellido}`
  ul.detalle
    li
      strong Sucursal:
      |  #{profesor.sucursal}
    li
      strong Días:
      |  #{profesor.dias.join(', ')}
    li
      strong Horarios:
      |  #{profesor.horarios.join(', ')}

  .acciones
    a.boton(href=`/profesores/${profesor._id}/editar`) Editar
    form(action=`/profesores/${profesor._id}/eliminar` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar a este profesor? Esta acción no se puede deshacer.')")
      button.eliminar(type="submit") Eliminar

  .volver 
   a(href="/profesores") Volver al listado
