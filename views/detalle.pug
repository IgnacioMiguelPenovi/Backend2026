extends layout

block content
  h2= libro.titulo
  ul.detalle
    li
      strong Autor:
      |  #{libro.autor}
    li
      strong Categoría:
      |  #{libro.categoria}
    li
      strong Año:
      |  #{libro.anio}

  a.boton(href=`/libros/${libro.id}/editar`) Editar
  form(action=`/libros/${libro.id}/eliminar` method="POST")
    button(type="submit") Eliminar
  a(href="/libros") Volver al listado
