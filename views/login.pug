extends layout

block content
    .login
        h2 Iniciar sesión
        if error
            p.error= error
        if mensaje
            p.mensaje-exito(style="text-align: center;")= mensaje
        form(action="/login" method="POST")
            label(for="user") Usuario
            input#user(
                type="text" 
                name="user" 
                required 
                minlength="3" 
                maxlength="30" 
                oninvalid="this.setCustomValidity('El usuario debe tener al menos 3 caracteres')" 
                oninput="this.setCustomValidity('')"
            )

            label(for="password") Contraseña
            .input-pass
                input#password(
                    type="password" 
                    name="password" 
                    required 
                    minlength="6" 
                    maxlength="50"
                    pattern=".*[@$!%*?&#._\\-].*"
                    oninvalid="validarPass(this)"
                    oninput="validarPass(this)"
                )
                button.toggle-pass(type="button" onclick="togglePassword(this)" title="Ver contraseña"): i#eyeIcon.fa-regular.fa-eye-slash

            button.boton(type="submit" disabled=bloqueado) Ingresar
            button.boton(type="button" onclick="window.location.href='/alumnos/nuevo'" disabled=bloqueado) Registrarse

    script.
      function validarPass(input) {
        const valor = input.value;
        const regexEspecial = /[@$!%*?&#._-]/;

        if (input.validity.valueMissing) {
          input.setCustomValidity('Por favor ingresá tu contraseña');
        } else if (valor.length < 6 || !regexEspecial.test(valor)) {
          input.setCustomValidity(
            'La contraseña debe tener al menos 6 caracteres e incluir un símbolo especial'
          );
        } else {
          input.setCustomValidity('');
        }
      }

    
