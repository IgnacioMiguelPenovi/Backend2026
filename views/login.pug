extends layout

block content
    .login
        h2 Iniciar sesión
        if error
            p.error= error
        form(action="/login" method="POST")
            label(for="user") Usuario
            input#user(
                type="text" 
                name="user" 
                required 
                minlength="3" 
                maxlength="30" 
                oninvalid="this.setCustomValidity('El usuario debe tener al menos 3 caracteres')" 
                oninput="this.setCustomValidity('')"
            )

            label(for="password") Contraseña
            .input-pass
                input#password(
                    type="password" 
                    name="password" 
                    required 
                    minlength="6" 
                    maxlength="50"
                    pattern=".*[@$!%*?&#._\\-].*"
                    oninvalid="validarPass(this)"
                    oninput="validarPass(this)"
                )
                button.toggle-pass(type="button" onclick="togglePassword()" title="Ver contraseña"): i#eyeIcon.fa-regular.fa-eye-slash

            button.boton(type="submit" disabled=bloqueado) Ingresar

    script.
      function validarPass(input) {
        const valor = input.value;
        const regexEspecial = /[@$!%*?&#._\-]/;

        if (input.validity.valueMissing) {
          input.setCustomValidity('Por favor ingresá tu contraseña');
        } else if (valor.length < 6) {
          input.setCustomValidity('La contraseña debe tener al menos 6 caracteres');
        } else if (!regexEspecial.test(valor)) {
          input.setCustomValidity('La contraseña debe incluir al menos un símbolo especial (*, !, @, #, $, etc.)');
        } else {
          input.setCustomValidity(''); // Válido, limpia el error para permitir enviar
        }
      }

      function togglePassword() {
        const input = document.getElementById('password');
        const icon = document.getElementById('eyeIcon');
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.replace('fa-eye-slash', 'fa-eye'); // cerrado → abierto
        } else {
          input.type = 'password';
          icon.classList.replace('fa-eye', 'fa-eye-slash'); // abierto → cerrado
        }
      }
    