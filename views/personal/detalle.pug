extends ../layout

block content
  h2= `${persona.nombre} ${persona.apellido}`
  ul.detalle
    li
      strong DNI:
      |  #{persona.dni || 'No informado'}
    li
      strong Email:
      |  #{persona.email || 'No informado'}
    li
      strong Teléfono:
      |  #{persona.telefono || 'No informado'}
    li
      strong Rol:
      |  #{persona.rol}
    li
      strong Estado:
      |  #{persona.estado === 'licencia' ? 'De licencia' : persona.estado === 'inactivo' ? 'Inactivo' : 'Activo'}
    if persona.rol === 'profesor'
      li
        strong Sucursal:
        |  #{persona.sucursal || 'No informada'}
      li
        strong Días:
        |  #{(persona.dias || []).join(', ') || 'No informados'}
      li
        strong Horarios:
        |  #{(persona.horarios || []).join(', ') || 'No informados'}

  .acciones
    a.boton(href=`/personal/${persona._id}/editar`) Editar
    if persona.estado === 'activo'
      form(action=`/personal/${persona._id}/desactivar` method="POST" onsubmit="return confirm('¿Seguro que querés desactivar a esta persona?')")
        button.desactivar(type="submit") Desactivar
    else
      form(action=`/personal/${persona._id}/activar` method="POST" onsubmit="return confirm('¿Querés activar a esta persona?')")
        button(type="submit") Activar

  .volver
    a.boton(href="/personal") Volver al listado
