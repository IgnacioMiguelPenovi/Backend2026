extends ../layout

block content
  h2 Empleados Registrados

  if personas.length === 0
    p Todavía no hay empleados registrados.
  else
    table
      thead
        tr
          th Nombre
          th Apellido
          th DNI
          th Email
          th Teléfono
          th Rol
          th Estado
          th Acciones
      tbody
        each persona in personas
          tr
            td= persona.nombre
            td= persona.apellido
            td= persona.dni
            td= persona.email
            td= persona.telefono
            td= persona.rol
            td= persona.estado === 'licencia' ? 'De licencia' : persona.estado === 'inactivo' ? 'Inactivo' : 'Activo'
            td
              a.boton(href=`/personal/${persona._id}`) Ver   
              a.boton(href=`/personal/${persona._id}/editar`) Editar
   
  .enlaces
    a.boton.grande(href="/personal/nuevo") Inscribir Empleado
    a.boton.grande(href="/index") Volver al Inicio
