extends ../layout

block content
  h2= titulo || 'Personal registrado'

  if personas.length === 0
    p No hay personas registradas en esta lista.
  else
    table
      thead
        tr
          th Nombre
          th Apellido
          th DNI
          th Email
          th Teléfono
          th Rol
          th Estado
          th Acciones
      tbody
        each persona in personas
          tr
            td= persona.nombre
            td= persona.apellido
            td= persona.dni
            td= persona.email
            td= persona.telefono
            td= persona.rol
            td= persona.estado === 'licencia' ? 'De licencia' : persona.estado === 'inactivo' ? 'Inactivo' : 'Activo'
            td
              a.boton(href=`/personal/${persona._id}`) Ver   
              if puedeEditar
                a.boton(href=`/personal/${persona._id}/editar`) Editar
   
  .enlaces
    if puedeEditar
      a.boton.grande(href="/personal/nuevo") Inscribir personal
    a.boton.grande(href="/index") Volver al Inicio
