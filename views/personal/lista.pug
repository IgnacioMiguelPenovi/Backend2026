extends ../layout

block content
  h2= titulo || 'Personal registrado'

  if personas.length === 0
    p No hay personas registradas en esta lista.
  else
    .buscador-personal
      label(for="buscar-personal") Buscar personal
      input#buscar-personal(type="search" placeholder="Nombre, apellido, usuario, rol o sucursal" autocomplete="off")

    .tabla-wrap
      table.tabla-datos
        thead
          tr
            th Nombre
            th DNI
            th Email
            th Teléfono
            th Rol
            th Estado
            th Acciones
        tbody
          each persona in personas
            tr(data-personal-row data-search=[persona.nombre, persona.apellido, persona.usuario, persona.rol, persona.sucursal, persona.dni, persona.email, persona.telefono, persona.estado].filter(Boolean).join(' '))
              td.col-nombre(data-label="Nombre")
                strong= persona.nombre
                |  
                = persona.apellido
              td.col-nowrap(data-label="DNI")= persona.dni
              td.col-email(data-label="Email")= persona.email
              td.col-nowrap(data-label="Teléfono")= persona.telefono
              td(data-label="Rol")= persona.rol
              td(data-label="Estado")
                - const estadoPersona = persona.estado === 'licencia' ? 'licencia' : persona.estado === 'inactivo' ? 'inactivo' : 'activo'
                - const textoPersona = persona.estado === 'licencia' ? 'De licencia' : persona.estado === 'inactivo' ? 'Inactivo' : 'Activo'
                span(class=`estado-badge estado-${estadoPersona}`)= textoPersona
              td.col-acciones(data-label="Acciones")
                .celda-acciones
                  a.boton(href=`/personal/${persona._id}`) Ver
                  if puedeEditar
                    a.boton(href=`/personal/${persona._id}/editar`) Editar
      p#sin-resultados(hidden) No se encontraron personas que coincidan con la búsqueda.

    script.
      const buscadorPersonal = document.getElementById('buscar-personal');
      const filasPersonal = [...document.querySelectorAll('[data-personal-row]')];
      const mensajeSinResultados = document.getElementById('sin-resultados');
      const normalizarBusqueda = texto => texto
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLocaleLowerCase();

      buscadorPersonal.addEventListener('input', () => {
        const consulta = normalizarBusqueda(buscadorPersonal.value.trim());
        let visibles = 0;

        filasPersonal.forEach(fila => {
          const coincide = normalizarBusqueda(fila.dataset.search || '').includes(consulta);
          fila.hidden = !coincide;
          if (coincide) visibles += 1;
        });

        mensajeSinResultados.hidden = visibles > 0;
      });

  .enlaces
    if puedeEditar
      a.boton.grande(href="/personal/nuevo") Inscribir personal
    a.boton.grande(href="/index") Volver al Inicio
