extends layout

block content
  h2 Añadir Turno

  if usuario
    p(style="text-align: center; color: #555; margin-bottom: 1.5rem;")
      | Reservando turno para: 
      strong #{usuario.nombre} (#{usuario.usuario})

  if error
    #error-duplicado= error

  form(action="/nuevoTurno" method="POST")
    label(for="sucursal") Sucursal
    select#sucursal(name="sucursal" required)
      option(value="" disabled selected=(!valores || !valores.sucursal)) Seleccione una sucursal
      each s in sucursales
        option(value=s selected=(valores && valores.sucursal === s))= s

    label(for="turnoDia") Día
    select#turnoDia(name="dia" required)
      option(value="" disabled selected=(!valores || !valores.dia)) Seleccione un día
      each d in dias
        option(value=d selected=(valores && valores.dia === d))= d

    label(for="turnoHorario") Horario
    select#turnoHorario(name="horario" required)
      option(value="" disabled selected=(!valores || !valores.horario)) Seleccione un horario
      each h in horarios
        option(value=h selected=(valores && valores.horario === h))= `${h} hs`

    label(for="motivo") Motivo o Comentario (opcional)
    input#motivo(
      type="text"
      name="motivo"
      placeholder="Ej. Clase de consulta, entrenamiento, etc."
      maxlength="200"
      value=(valores && valores.motivo ? valores.motivo : '')
    )

    .acciones
      button(type="submit") Confirmar Turno
      a.boton.grande.cancelar(href="/index") Cancelar
