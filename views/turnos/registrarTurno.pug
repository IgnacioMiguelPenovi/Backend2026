extends ../layout

block content
  h2 Mis Turnos Reservados

  if !turnos || turnos.length === 0
    p(style="text-align: center; margin: 2rem 0; color: #555;") Todavía no tenés ningún turno reservado.
  else
    .tabla-wrap
      table.tabla-datos
        thead
          tr
            th Sucursal
            th Fecha
            th Día
            th Horario
            th Motivo
            th Estado
            th Reservado el
        tbody
          each turno in turnos
            tr
              td.col-nombre(data-label="Sucursal")
                strong= turno.sucursal
              td.col-nowrap(data-label="Fecha")= turno.fecha ? new Date(turno.fecha).toISOString().split('T')[0].split('-').reverse().join('/') : '-'
              td(data-label="Día")= turno.dia
              td.col-nowrap(data-label="Horario")= `${turno.horario} hs`
              td(data-label="Motivo")= turno.motivo || '-'
              td(data-label="Estado")
                span(class='estado-badge estado-' + turno.estado)= turno.estado === 'confirmado' ? 'Confirmado' : turno.estado === 'cancelado' ? 'Cancelado' : 'Pendiente'
              td.col-nowrap(data-label="Reservado el")= turno.creadoEn ? new Date(turno.creadoEn).toLocaleDateString('es-AR') : '-'

  .acciones
    a.boton.grande(href="/nuevoTurno") Agendar turno
    a.boton.grande.cancelar(href="/index") Volver al Inicio
