doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="/css/style.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
    title= titulo || 'Tp1'
    
  body
    header
      h1
        if usuario
          a(href="/index") TurnoFlex
        else
          a(href="/") TurnoFlex
      if usuario
          form.logout(method="POST" action="/logout" id="logoutForm")
            button.salir(type="submit") Cerrar Sesión
    main
      block content

    script.
      function togglePassword(button) {
        const contenedor = button.closest('.input-pass');
        const input = contenedor.querySelector('input');
        const icono = button.querySelector('i');
        const mostrar = input.type === 'password';

        input.type = mostrar ? 'text' : 'password';
        icono.classList.toggle('fa-eye', mostrar);
        icono.classList.toggle('fa-eye-slash', !mostrar);
        button.title = mostrar ? 'Ocultar contraseña' : 'Ver contraseña';
      }
