extends ../layout

block content
  - const estado = alumno.estado || 'activo'
  h2= `${alumno.nombre} ${alumno.apellido}`
  if mensaje
    p.mensaje-exito= mensaje
  ul.detalle
    li
      strong DNI:
      |  #{alumno.dni || 'No informado'}
    li
      strong Email:
      |  #{alumno.email || 'No informado'}
    li
      strong Teléfono:
      |  #{alumno.telefono || 'No informado'}
    li
      strong Estado:
      |  #{estado === 'licencia' ? 'De licencia' : estado === 'inactivo' ? 'Inactivo' : 'Activo'}
    li
      strong Sucursal:
      |  #{alumno.sucursal}
    li 
      strong Fecha de Nacimiento:
      |  #{alumno.fechaNacimiento ? alumno.fechaNacimiento.toISOString().split('T')[0] : 'No informado'}


  if puedeEditar
    .acciones
      a.boton(href=`/alumnos/${alumno._id}/editar`) Editar
      if estado === 'activo'
        form(action=`/alumnos/${alumno._id}/desactivar` method="POST" onsubmit="return confirm('¿Seguro que querés desactivar a este alumno?')")
          button.desactivar(type="submit") Desactivar
      else
        form(action=`/alumnos/${alumno._id}/activar` method="POST")
          button(type="submit") Activar

  .volver 
    a.boton(href="/alumnos") Volver al listado
