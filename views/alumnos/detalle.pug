extends ../layout

block content
  - const activo = alumno.activo !== false
  h2= `${alumno.nombre} ${alumno.apellido}`
  ul.detalle
    li
      strong Estado:
      | #{activo ? 'Activo' : 'Inactivo'}
    li
      strong Sucursal:
      |  #{alumno.sucursal}
    li
      strong Turno:
      |  #{alumno.turnoDia} - #{alumno.turnoHorario}



  .acciones
    a.boton(href=`/alumnos/${alumno._id}/editar`) Editar
    if activo
      form(action=`/alumnos/${alumno._id}/desactivar` method="POST" onsubmit="return confirm('¿Seguro que querés desactivar a este alumno?')")
        button.desactivar(type="submit") Desactivar
    else
      form(action=`/alumnos/${alumno._id}/activar` method="POST")
        button(type="submit") Activar

  .volver 
   a(href="/alumnos") Volver al listado
