extends ../layout

block content
  h2= `${alumno.nombre} ${alumno.apellido}`
  ul.detalle
    li
      strong Sucursal:
      |  #{alumno.sucursal}
    li
      strong Turno:
      |  #{alumno.turnoDia} - #{alumno.turnoHorario}

  a.boton(href=`/alumnos/${alumno._id}/editar`) Editar
  form(action=`/alumnos/${alumno._id}/eliminar` method="POST")
    button(type="submit") Eliminar
  a(href="/alumnos") Volver al listado
