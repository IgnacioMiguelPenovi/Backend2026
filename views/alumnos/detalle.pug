extends ../layout

block content
  h2= `${alumno.nombre} ${alumno.apellido}`
  ul.detalle
    li
      strong Sucursal:
      |  #{alumno.sucursal}
    li
      strong Turno:
      |  #{alumno.turnoDia} - #{alumno.turnoHorario}



  .acciones
    a.boton(href=`/alumnos/${alumno._id}/editar`) Editar
    form(action=`/alumnos/${alumno._id}/eliminar` method="POST" onsubmit="return confirm('¿Seguro que querés eliminar a este alumno? Esta acción no se puede deshacer.')")
      button.eliminar(type="submit") Eliminar

  .volver 
   a(href="/alumnos") Volver al listado
