extends ../layout

block content
  h2 Sucursales Registradas

  if sucursales.length === 0
    p No hay sucursales dadas de alta en el sistema.
  else
    .tabla-wrap
      table.tabla-datos
        thead
          tr
            th Nombre
            th Dirección
            th Teléfono
            th Estado
            th Acciones
        tbody
          each sucursal in sucursales
            tr
              td.col-nombre(data-label="Nombre")
                strong= sucursal.nombre
              td(data-label="Dirección")= sucursal.direccion
              td.col-nowrap(data-label="Teléfono")= sucursal.telefono
              td(data-label="Estado")
                - const estadoSuc = sucursal.estado === 'activo' ? 'activo' : 'inactivo'
                span(class=`estado-badge estado-${estadoSuc}`)= sucursal.estado === 'activo' ? 'Activo' : 'Inactivo'
              td.col-acciones(data-label="Acciones")
                .celda-acciones
                  a.boton(href=`/sucursales/${sucursal._id}`) Ver
                  if puedeEditar
                    a.boton(href=`/sucursales/${sucursal._id}/editar`) Editar

  .enlaces
    if puedeEditar
      a.boton.grande(href="/sucursales/nuevo") Nueva sucursal
    a.boton.grande(href="/index") Volver al Inicio
