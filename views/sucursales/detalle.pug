extends ../layout

block content
  - const activo = sucursal.estado === 'activo'
  h2= sucursal.nombre
  ul.detalle
    li
      strong Dirección:
      |  #{sucursal.direccion || 'No informado'}
    li
      strong Teléfono:
      |  #{sucursal.telefono || 'No informado'}
    li
      strong Estado:
      | #{activo ? 'Activo' : 'Inactivo'}



  if puedeEditar
    .acciones
      a.boton(href=`/sucursales/${sucursal._id}/editar`) Editar
      if activo
        form(action=`/sucursales/${sucursal._id}/desactivar` method="POST" onsubmit="return confirm('¿Seguro que querés desactivar a esta sucursal?')")
          button.desactivar(type="submit") Desactivar
      else
        form(action=`/sucursales/${sucursal._id}/activar` method="POST")
          button(type="submit") Activar

  .volver 
    a.boton(href="/sucursales") Volver al listado
